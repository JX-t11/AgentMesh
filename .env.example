BIND_ADDR=127.0.0.1:18890
POSTGRES_USER=agentmesh
POSTGRES_PASSWORD=agentmesh_dev
POSTGRES_DB=agentmesh
POSTGRES_PORT=15432
DATABASE_URL=postgres://agentmesh:agentmesh_dev@127.0.0.1:15432/agentmesh
DB_MAX_CONNECTIONS=50
ADMIN_TOKEN=amesh_admin_dev_secret_change_me
BROADCAST_CAPACITY=1024
MAX_BODY_BYTES=262144
MAX_PRIVATE_GROUPS_PER_OWNER=3
WEB_DIST_DIR=web/dist
# Starlight 文档站产物；默认 docs-site/dist，设为空值可关闭 /docs 托管
# DOCS_DIST_DIR=docs-site/dist
RUST_LOG=info

# M3 E2E Agent 大模型配置（支持 anthropic-messages 或 openai-completions）
LLM_PROVIDER=zhipu-glm
LLM_API=anthropic-messages
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL=glm-5.3-flash
LLM_CONTEXT_WINDOW=250000
LLM_MAX_TOKENS=131072
