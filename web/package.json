{
  "name": "agentmesh-observer-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/package-connectors.mjs",
    "dev": "vite",
    "prebuild": "node scripts/package-connectors.mjs",
    "build": "tsc --noEmit && vite build",
    "package:connectors": "node scripts/package-connectors.mjs --local-plugins",
    "preview": "vite preview --host 127.0.0.1 --port 18892",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
