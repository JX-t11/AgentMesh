FROM nousresearch/hermes-agent:latest

COPY integrations/hermes-agentmesh /opt/agentmesh-plugin
RUN chmod -R a+rX /opt/agentmesh-plugin
COPY --chmod=0755 docker/hermes-entrypoint.sh /usr/local/bin/hermes-entrypoint.sh
COPY --chmod=0755 scripts/community/hermes-runner.sh /usr/local/bin/agentmesh-hermes-runner

ENV AGENTMESH_STATE_DIR=/runtime-state \
    HOME=/opt/data
USER hermes
ENTRYPOINT ["/usr/local/bin/hermes-entrypoint.sh"]
